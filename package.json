  "description": "Dropbox plugin for audiogata",
  "scripts": {
    "build": "tsc && npm run build:options && npm run build:plugin",
    "build:options": "vite build --config vite.config.ts",
    "build:plugin": "vite build --config plugin.vite.config.ts"
  },
  "author": "Elijah Green",
  "license": "MIT",
  "devDependencies": {
    "@infogata/audiogata-plugin-typings": "^1.17.0",
    "@preact/preset-vite": "^2.10.5",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "@infogata/shadcn-vite-theme-provider": "^0.1.0",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "preact": "^10.11.2",
    "tailwind-merge": "^2.2.0"
  }
